# ── 服务配置 ──────────────────────────────────
PORT=8111
NODE_ENV=development

# ── 数据库 ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=ssodb

# ── JWT ────────────────────────────────────────
# 生产环境使用 openssl rand -base64 64 生成
JWT_SECRET=your_super_secret_key_min_32_chars

# ── CORS ───────────────────────────────────────
# 逗号分隔，支持多个前端域名
CORS_ORIGINS=http://localhost:3000,http://localhost:3111

# ── Google OAuth2 ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8111/api/oauth/google/callback

# ── 微信 OAuth2（公众号） ────────────────────────
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_CALLBACK_URL=http://localhost:8111/api/oauth/wechat/callback

# ── OAuth 成功后的前端重定向地址 ─────────────────
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/oauth/callback

# ── 微信小程序 ────────────────────────────────
WECHAT_MINIAPP_APP_ID=your_miniapp_app_id
WECHAT_MINIAPP_APP_SECRET=your_miniapp_app_secret
